{
  "name": "base-monorepo-v2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "docker:local": "docker compose -f .\\docker\\compose.local.yml  --env-file config/.env.local up",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @base-monorepo-v2/db --",
    "db:studio": "turbo run db:studio -F @base-monorepo-v2/db --",
    "db:generate": "turbo run db:generate -F @base-monorepo-v2/db --",
    "db:migrate": "turbo run db:migrate -F @base-monorepo-v2/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "format": "prettier --write .",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@base-monorepo-v2/config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,md}": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@10.33.0"
}
