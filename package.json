{
  "name": "excellense-mono",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^26.4.1",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "axios": "^1.16.1",
      "bullmq": "5.71.0",
      "dotenv": "^17.4.2",
      "firebase-admin": "^14.5.0",
      "ioredis": "5.9.3",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "pino": "^10.3.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "typescript": "6.0.2",
      "varlock": "1.18.0",
      "zod": "^4.5.4"
    }
  },
  "trustedDependencies": [
    "@firebase/util",
    "@infisical/cli",
    "@prisma/client",
    "@prisma/engines",
    "bcrypt",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "protobufjs",
    "sharp"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "@infisical/cli": "^0.44.11",
    "env:init": "./node_modules/@infisical/cli/bin/infisical.exe init",
    "env:login": "./node_modules/@infisical/cli/bin/infisical.exe login",
    "env:pull:local": "./node_modules/@infisical/cli/bin/infisical.exe export --env=dev --path=/local --format=dotenv --output-file=./config/.env.local",
    "env:pull:server": "./node_modules/@infisical/cli/bin/infisical.exe export --env=dev --path=/server --format=dotenv --output-file=./apps/server/.env",
    "env:pull:landing": "./node_modules/@infisical/cli/bin/infisical.exe export --env=dev --path=/landing --format=dotenv --output-file=./apps/landing/.env",
    "env:pull:db": "./node_modules/@infisical/cli/bin/infisical.exe export --env=dev --path=/db --format=dotenv --output-file=./packages/db/.env",
    "env:pull:all": "bun run env:pull:local && bun run env:pull:server && bun run env:pull:landing && bun run env:pull:db",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "check-types": "bun --filter '*' check-types",
    "docker:local": "docker compose -f ./docker/compose.local.yml --env-file config/.env.local up",
    "dev:web": "bun --filter web dev",
    "dev:server": "bun --filter server dev",
    "dev:landing": "bun --filter landing dev",
    "db:push": "bun --cwd packages/db db:push",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:reset": "bun --cwd packages/db db:reset",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ ",
    "format": "prettier --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@excellense/config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "@infisical/cli": "^0.45.8",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,md}": "prettier --write --ignore-unknown"
  },
  "packageManager": "bun@1.4.5"
}
