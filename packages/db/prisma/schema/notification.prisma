enum DevicePreferredLanguage {
    AR
    EN
}

enum DevicePlatform {
    IOS
    ANDROID
}

model Device {
    id  String @id @default(uuid()) @db.Uuid
    fid String @unique

    userId String  @db.Uuid
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    platform     DevicePlatform
    appVersion   String?
    buildNumber  String?
    osVersion    String?
    model        String?
    manufacturer String?
    language     DevicePreferredLanguage
    locale       String?
    timezone     String?
    // notificationsEnabled Boolean                 @default(true) // OS permission state

    lastSeenAt DateTime @default(now())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([userId])
    @@map("devices")
}
