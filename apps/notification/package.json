{
  "name": "notification",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.mjs"
  },
  "dependencies": {
    "@excellense/env": "workspace:*",
    "@excellense/redis": "workspace:*",
    "@excellense/contracts": "workspace:*",
    "@excellense/db": "workspace:*",
    "bullmq": "catalog:",
    "firebase-admin": "catalog:",
    "pino": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@excellense/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
